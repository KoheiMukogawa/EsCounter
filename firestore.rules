rules_version = '2';

// 本番反映済みのルール（2026-08-31、Firebase MCP `firebase_get_security_rules` で取得し、
// このリポジトリに同期）。ESM のデータは users/{uid} の1ドキュメントに集約されている。
// 本人以外は読み書きできない。
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
